# Copy to `.env.production` for production Supabase + Cloudflare Worker API — NEVER commit `.env.production`
# Task 10.21 — production baseline only (names only; fill via operator from new Supabase account)

APP_ENV=production
# Domain model (Task 10.23a):
#   narraza.web.id      = homepage / landing / marketing (NOT the dashboard)
#   app.narraza.web.id  = app / dashboard (Cloudflare Pages)
#   api.narraza.web.id  = API (Cloudflare Workers)
ALLOWED_ORIGINS=https://narraza.web.id,https://www.narraza.web.id,https://app.narraza.web.id

# Dedicated production Supabase (MUST NOT be staging ref jdxyhrnibmmwlbtbokqo)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CLI auth for production account (not staging account) — never commit
# SUPABASE_ACCESS_TOKEN=

# Database password for `supabase link --password` / `db push` — never commit
# SUPABASE_DB_PASSWORD=

# Live Duitku — keep merchant credentials only in Worker secrets / gitignored env.
CREDIT_TOPUP_ENABLED=true
PAYMENT_PROVIDER=duitku
PAYMENT_PROVIDER_MOCK=false

# Live OpenRouter — API Worker ONLY. Never in apps/web or git.
AI_GENERATION_ENABLED=true
AI_PROVIDER_MOCK=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Hemat tier default gemma-2-9b-it may 404 on OpenRouter — set working allowlisted model:
AI_MODEL_HEMAT=google/gemma-4-31b-it:free
AI_MODEL_SEIMBANG=google/gemma-4-31b-it:free
AI_MODEL_TERBAIK=google/gemma-4-31b-it:free
DEFAULT_AI_MODEL=google/gemma-4-31b-it:free

# Node local only; ignored by Cloudflare Workers.
PORT=8787

DUITKU_ENV=production
DUITKU_MERCHANT_CODE=
DUITKU_MERCHANT_KEY=
DUITKU_CALLBACK_URL=https://api.narraza.web.id/api/payments/duitku/callback
DUITKU_RETURN_URL=https://app.narraza.web.id/credits/topup/return

# Web production build (Cloudflare Pages app — never commit keys)
# VITE_API_URL=https://api.narraza.web.id
# VITE_PUBLIC_SITE_URL=https://narraza.web.id
# VITE_APP_URL=https://app.narraza.web.id
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_USE_MOCKS=false
